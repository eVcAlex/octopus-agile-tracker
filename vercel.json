{
  "rewrites": [
    {
      "source": "/proxy/forecast/:region",
      "destination": "https://prices.fly.dev/api/:region/?format=json"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/rates-published",
      "schedule": "0 15,16,17,18 * * *"
    },
    {
      "path": "/api/cron/cheap-window",
      "schedule": "*/15 * * * *"
    }
  ]
}
