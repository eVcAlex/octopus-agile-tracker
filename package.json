    "@vite-pwa/assets-generator": "^1.0.2",
    "@vitejs/plugin-react": "5.0.0",
    "oxfmt": "0.54.0",
    "oxlint": "1.69.0",
    "postcss": "8.5.6",
    "postcss-preset-mantine": "1.18.0",
    "sass": "1.92.1",
