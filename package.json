{
  "name": "octopus-agile-tracker",
  "description": "Dashboard for Octopus Energy Agile electricity prices and gas unit rates — today/tomorrow rates, wholesale-derived estimates, forecasts, usage spend, and push alerts",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/eVcAlex/octopus-agile-tracker.git"
  },
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "dev:server": "tsx watch server/src/index.ts",
    "typecheck:server": "tsc -p server"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp"
    ]
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
